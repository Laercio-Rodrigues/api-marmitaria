generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  orders    Order[]
  createdAt DateTime @default(now())
}

enum Role {
  CUSTOMER
  ADMIN
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String
  price       Float
  imageUrl    String?
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Order {
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  user       User            @relation(fields: [userId], references: [id])
  userId     String          @db.ObjectId
  status     OrderStatus     @default(PENDING)
  totalPrice Float
  items      OrderItem[]
  address    DeliveryAddress
  createdAt  DateTime        @default(now())
}

type DeliveryAddress {
  street     String
  number     String
  district   String
  city       String
  complement String?
  latitude   Float
  longitude  Float
}

type OrderItem {
  productId String @db.ObjectId
  name      String
  quantity  Int
  unitPrice Float
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}
